COMMAND ["$WORK/before/build/pcre2test", "-32", "$COLLECTION/pcre2-recursion/cases.txt"]
PCRE2 version 10.50-DEV 2026-11-31 (32-bit)
# Whole-pattern recursion may backtrack through terminal iterators.

/(?:b(?R)a|a+)/B
------------------------------------------------------------------
        Bra
        Bra
        b
        Recurse
        a
        Alt
        a++
        Ket
        Ket
        End
------------------------------------------------------------------
    baa
 0: aa
    bbaaa
 0: aaa
    baaa
 0: aaa

/(?:b(?0)a|a+)/B
------------------------------------------------------------------
        Bra
        Bra
        b
        Recurse
        a
        Alt
        a++
        Ket
        Ket
        End
------------------------------------------------------------------
    baa
 0: aa

# Local subroutine calls do not re-enter the whole pattern.

/(?<r>b(?&r)a|x)a+/B
------------------------------------------------------------------
        Bra
        CBra 1
        b
        Recurse
        a
        Alt
        x
        Ket
        a++
        Ket
        End
------------------------------------------------------------------
    xaa
 0: xaa
 1: x
    bxaaa
 0: bxaaa
 1: bxa

EXIT 0
